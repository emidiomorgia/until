{
  "name": "until",
  "short_name": "until",
  "id": "/app/",
  "description": "A clearer way to move forward.",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
